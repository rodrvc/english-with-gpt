# Credencial del proveedor de IA. Solo vive en el servidor; nunca en el frontend.
OPENAI_API_KEY=sk-...
# Modelo con soporte de structured outputs.
OPENAI_MODEL=gpt-5.4-mini
# Puerto del backend.
PORT=3001
# Orígenes permitidos por CORS, separados por coma.
WEB_ORIGIN=http://localhost:5173
# Ruta de la base SQLite (relativa a apps/api). Usa :memory: para efímera.
DATABASE_PATH=./data/practice.db
# Longitud máxima del texto de una redacción (unidades UTF-16).
MAX_TEXT_LENGTH=4000
# Límite de evaluaciones por ventana (opcional).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
